# 리포 루트 .env로 복사해 채운다(.env는 .gitignore). 배포 때는 K8s Secret이 같은 이름으로 넣는다.

# petmint 앱 계정 — 앱(app/)과 db/migrate.py
PETMINT_DB_HOST=127.0.0.1
PETMINT_DB_PORT=3306
PETMINT_DB_NAME=petmint
PETMINT_DB_USER=petmint_app
PETMINT_DB_PASSWORD=

# runshoes — 자리만. db/bootstrap.py가 계정·데이터베이스를 만든다
RUNSHOES_DB_HOST=127.0.0.1
RUNSHOES_DB_PORT=3306
RUNSHOES_DB_NAME=runshoes
RUNSHOES_DB_USER=runshoes_app
RUNSHOES_DB_PASSWORD=

# 기간계 흉내(insurance_core) — 적재·수정 계정. db/seed_insurance_core.py와 db/migrate --app insurance_core
INSURANCE_SEED_DB_HOST=127.0.0.1
INSURANCE_SEED_DB_PORT=3306
INSURANCE_SEED_DB_NAME=insurance_core
INSURANCE_SEED_DB_USER=insurance_seed
INSURANCE_SEED_DB_PASSWORD=

# 앱이 고객 원장을 읽는 접속(SELECT만). 개발은 같은 인스턴스·같은 petmint_app 계정, 실무는 기간계 쪽 주소·계정
PETMINT_CORE_DB_HOST=127.0.0.1
PETMINT_CORE_DB_PORT=3306
PETMINT_CORE_DB_NAME=insurance_core
PETMINT_CORE_DB_USER=petmint_app
PETMINT_CORE_DB_PASSWORD=

# db/bootstrap.py만 쓴다. root 비밀번호는 파일에 두지 말고 실행할 때 넘긴다:
#   MYSQL_ROOT_PASSWORD=... python -m db.bootstrap
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# 상담원 신원 — Cloudflare Access 헤더가 없을 때(로컬 개발) 쓰는 값
PETMINT_DEFAULT_AGENT=dev@local

# 세션 제목 요약에 모델을 부를지(0이면 첫 질문을 잘라 쓴다 — GPU를 쓰면 안 될 때)
PETMINT_TITLE_LLM=1

# ---- 아래는 기본값이 있다. 컨테이너(Pod)에서는 호스트·볼륨을 가리키게 바꾼다 ----
# GPU 호스트의 서비스 — Pod에서 localhost는 Pod 자신이다
# PETMINT_OLLAMA_URL=http://localhost:11434
# PETMINT_SEARCH_URL=http://localhost:8100
# PETMINT_MILVUS_URL=http://localhost:19530     # 조항 원문(ContextBuilder)

# Ollama 모델 이름(app/config.py) — 어댑터를 바꾸면 RAG 쪽만 바꾼다
# PETMINT_MODEL_BASE=tri-7b
# PETMINT_MODEL_RAG=tri-7b-rag-1

# 약관 청크·참조 그래프 — 이미지·git에 넣지 않는다. 기본값은 리포의 data/chunks·data/graph(이미지는 /var/lib/petmint/*)
# PETMINT_CHUNKS_DIR=
# PETMINT_GRAPH_DIR=
# React 빌드물 — 있으면 / 에서 서빙
# PETMINT_WEB_DIST=
