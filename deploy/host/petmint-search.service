# search-service — GPU 호스트에서 KURE·리랭커·Milvus 검색을 HTTP로 낸다(search_service/main.py, 192.168.122.1:8100).
# 2026-11-02까지는 손으로 띄운 프로세스라 재부팅하면 사라졌다. 시스템 유닛으로 둔다.
#
# 설치(sudo):
#   sudo cp deploy/host/petmint-search.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now petmint-search
#
# 순서: docker(milvus·ollama 컨테이너)와 libvirtd(192.168.122.1을 가진 virbr0) 뒤에 뜬다.
# After=docker.service는 dockerd가 준비된 시점까지만 기다리고 컨테이너는 보지 않는다 — ExecStartPre가 Milvus
# healthz(127.0.0.1:9091)를 최대 240초 기다린다. 넘으면 실패로 끝나고 Restart가 15초 뒤 다시 시도한다(무한 대기 없음).
# 기다린 뒤에도 virbr0가 늦거나 Milvus 연결이 실패하면 기동이 실패로 끝나고 같은 Restart가 다시 띄운다.

[Unit]
Description=petmint search-service (KURE + reranker + Milvus, :8100)
After=network-online.target docker.service libvirtd.service
Wants=network-online.target docker.service libvirtd.service

[Service]
Type=simple
User=kopo17
Group=kopo17
WorkingDirectory=/home/kopo17/AI_programming/petmint-rag-chatbot
Environment=VIRTUAL_ENV=/home/kopo17/llm_env
Environment=PATH=/home/kopo17/llm_env/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
# Milvus가 뜰 때까지 기다린다(deploy/host/milvus — etcd 리더를 기다린 뒤 Milvus가 뜨므로 healthz면 둘 다 준비됨)
ExecStartPre=/usr/bin/timeout 240 /bin/sh -c 'until /usr/bin/curl -sf -m 2 -o /dev/null http://127.0.0.1:9091/healthz; do sleep 2; done'
ExecStart=/home/kopo17/llm_env/bin/python -m search_service.main
StandardOutput=append:/home/kopo17/AI_programming/petmint-rag-chatbot/logs/search_service.log
StandardError=append:/home/kopo17/AI_programming/petmint-rag-chatbot/logs/search_service.log
Restart=on-failure
RestartSec=15
# ExecStartPre(Milvus 대기 최대 240초) + 모델 두 개를 GPU에 올리는 30초 안팎 — 넉넉히
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target
